# Example Apache Felix ConfigAdmin config for Meter.Chint.DDSU666
# Copy this file (renamed to something like ddsu666-meter0.config) into:
#   /etc/openems.d/Meter/Chint/DDSU666/
# and restart OpenEMS Edge (or use Felix File Install for hot-load).
#
# Adjust modbusUnitId to match the DIP-switch slave address on your DDSU666.
# Adjust modbus.id to match your Bridge.Modbus.Serial (RTU) component ID.

:org.apache.felix.configadmin.revision:=L"1"
alias=""
enabled=B"true"
id="meter0"
invert=B"false"
modbus.id="modbus0"
modbusUnitId=I"2"
service.factoryPid="Meter.Chint.DDSU666"
service.pid="Meter.Chint.DDSU666.meter0"
type="GRID"
