msgid ""
"__As of: 2026-11-02 · OpenEMS version 2026.11.0-SNAPSHOT (development "
"version, branch develop)__"
msgstr ""
"__Stand: 02.11.2026 · OpenEMS-Version 2026.11.0-SNAPSHOT (Entwicklungsstand, "
