msgstr ""

#. type: #sec-tests
#: modules/ROOT/pages/development/implementing/apps.adoc
msgid "Three places in the bundle `+io.openems.edge.core+`:"
msgstr ""

#. type: #sec-tests
#: modules/ROOT/pages/development/implementing/apps.adoc
msgid "**1. Helper in `+Apps.java+`:**"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/apps.adoc
#, no-wrap
msgid ""
"public static final AppCleverPv cleverPv(AppManagerTestBundle t) {\n"
"\treturn app(t, AppCleverPv::new, \"App.Cloud.Clever-PV\");\n"
"}\n"
msgstr ""

#. type: Plain text
#: modules/ROOT/pages/development/implementing/apps.adoc
msgid ""
"**2. Entry in `+TestTranslations+`**, parameters: app, check form, "
"properties:"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/apps.adoc
#, no-wrap
msgid "this.apps.add(new TestTranslation(Apps.modbusTcpApiReadOnly(t), true, new JsonObject()));\n"
msgstr ""

#. type: Plain text
#: modules/ROOT/pages/development/implementing/apps.adoc
msgid "**3. Own test** (template `+AppCleverPvTest+`):"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/apps.adoc
#, no-wrap
msgid ""
"@BeforeEach\n"
"void beforeEach() throws Exception {\n"
"\tthis.appManagerTestBundle = new AppManagerTestBundle(null, null, t -> List.of(//\n"
"\t\t\tthis.cleverPv = Apps.cleverPv(t) //\n"
"\t), null, new PseudoComponentManagerFactory());\n"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/apps.adoc
#, no-wrap
msgid ""
"\tfinal var componentTask = this.appManagerTestBundle.addComponentAggregateTask();\n"
"\tthis.appManagerTestBundle.addSchedulerByCentralOrderAggregateTask(componentTask);\n"
"}\n"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/apps.adoc
#, no-wrap
msgid ""
"@Test\n"
"void testInstall() throws Exception {\n"
"\tthis.appManagerTestBundle.sut.handleAddAppInstanceRequest(DUMMY_ADMIN,\n"
"\t\t\tnew AddAppInstance.Request(this.cleverPv.getAppId(), \"key\", \"alias\", properties));\n"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/apps.adoc
#, no-wrap
msgid ""
"\tthis.appManagerTestBundle.assertComponentExist(new EdgeConfig.Component(\"ctrl0\", \"alias\", \"Controller.X\", //\n"
"\t\t\tJsonUtils.buildJsonObject().build()));\n"
"}\n"
msgstr ""

#. type: Plain text
#: modules/ROOT/pages/development/implementing/apps.adoc
msgid "`+withApp(app).hasOnlyProperties(…)+` checks the list of properties."
msgstr ""

#. type: Plain text
#: modules/ROOT/pages/development/implementing/apps.adoc
msgid ""
"The form is returned by `+app.getAppAssistant(DUMMY_ADMIN).fields+`; this "
"allows selection entries to be checked (template: "
"`+EvcsPropsArchitectureTypeTest+`)."
msgstr ""

#. type: Plain text
#: modules/ROOT/pages/development/implementing/apps.adoc
msgid ""
"Additional components are added to the test via `+"
"((DummyPseudoComponentManager) "
"appManagerTestBundle.componentManger).addComponent(…)+`."
msgstr ""

