#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"@Designate(ocd = Config.class, factory = true)\n"
"@Component(\n"
"        name = \"Controller.Symmetric.Balancing\",    // Factory-PID, never change\n"
"        immediate = true,\n"
"        configurationPolicy = ConfigurationPolicy.REQUIRE)\n"
"@GenerateTargetsFromReferences({ \"ess\", \"meter\" })\n"
"public class ControllerEssBalancingImpl extends AbstractOpenemsComponent\n"
"        implements Controller, OpenemsComponent, ModbusSlave, ControllerEssBalancing {\n"
msgstr ""
"@Designate(ocd = Config.class, factory = true)\n"
"@Component(\n"
"        name = \"Controller.Symmetric.Balancing\",    // Factory-PID, nie ändern\n"
"        immediate = true,\n"
"        configurationPolicy = ConfigurationPolicy.REQUIRE)\n"
"@GenerateTargetsFromReferences({ \"ess\", \"meter\" })\n"
"public class ControllerEssBalancingImpl extends AbstractOpenemsComponent\n"
"        implements Controller, OpenemsComponent, ModbusSlave, ControllerEssBalancing {\n"

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"    @Reference(policy = STATIC, policyOption = GREEDY, cardinality = MANDATORY,\n"
"            target = \"(&(id=${config.ess_id})(enabled=true))\")\n"
"    private ManagedSymmetricEss ess;\n"
msgstr ""
"    @Reference(policy = STATIC, policyOption = GREEDY, cardinality = MANDATORY,\n"
"            target = \"(&(id=${config.ess_id})(enabled=true))\")\n"
"    private ManagedSymmetricEss ess;\n"

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"    @Reference(policy = STATIC, policyOption = GREEDY, cardinality = MANDATORY,\n"
"            target = \"(&(id=${config.meter_id})(enabled=true))\")\n"
"    private ElectricityMeter meter;\n"
msgstr ""
"    @Reference(policy = STATIC, policyOption = GREEDY, cardinality = MANDATORY,\n"
"            target = \"(&(id=${config.meter_id})(enabled=true))\")\n"
"    private ElectricityMeter meter;\n"

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid "    private Config config;\n"
msgstr "    private Config config;\n"

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"    public ControllerEssBalancingImpl() {\n"
"        super(OpenemsComponent.ChannelId.values(),\n"
"              Controller.ChannelId.values(),\n"
"              ControllerEssBalancing.ChannelId.values());\n"
"    }\n"
msgstr ""
"    public ControllerEssBalancingImpl() {\n"
"        super(OpenemsComponent.ChannelId.values(),\n"
"              Controller.ChannelId.values(),\n"
"              ControllerEssBalancing.ChannelId.values());\n"
"    }\n"

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"    @Activate\n"
"    private void activate(ComponentContext context, Config config) {\n"
"        super.activate(context, config.id(), config.alias(), config.enabled());\n"
"        this.config = config;\n"
"    }\n"
msgstr ""
"    @Activate\n"
"    private void activate(ComponentContext context, Config config) {\n"
"        super.activate(context, config.id(), config.alias(), config.enabled());\n"
"        this.config = config;\n"
"    }\n"

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"    @Override\n"
"    @Deactivate\n"
"    protected void deactivate() {\n"
"        super.deactivate();\n"
"    }\n"
msgstr ""
"    @Override\n"
"    @Deactivate\n"
"    protected void deactivate() {\n"
"        super.deactivate();\n"
"    }\n"

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"    @Override\n"
"    public void run() throws OpenemsNamedException {\n"
"        if (!this.ess.isOnGridOrUndefined(m -> this.logWarn(this.log, m))) {\n"
"            return;\n"
"        }\n"
"        int target = this.getSetGridActivePowerNextWriteValue()\n"
"                .orElse(this.config.targetGridSetpoint());\n"
"        var power = this.meter.getActivePower().getOrError()\n"
"                + this.ess.getActivePower().getOrError() - target;\n"
"        this.ess.setActivePowerEqualsWithFilter(power);\n"
"        this.ess.setReactivePowerEqualsWithoutFilter(0);\n"
"    }\n"
"}\n"
msgstr ""
"    @Override\n"
"    public void run() throws OpenemsNamedException {\n"
"        if (!this.ess.isOnGridOrUndefined(m -> this.logWarn(this.log, m))) {\n"
"            return;\n"
"        }\n"
"        int target = this.getSetGridActivePowerNextWriteValue()\n"
"                .orElse(this.config.targetGridSetpoint());\n"
"        var power = this.meter.getActivePower().getOrError()\n"
"                + this.ess.getActivePower().getOrError() - target;\n"
"        this.ess.setActivePowerEqualsWithFilter(power);\n"
"        this.ess.setReactivePowerEqualsWithoutFilter(0);\n"
"    }\n"
"}\n"

