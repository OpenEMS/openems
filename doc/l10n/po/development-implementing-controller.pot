#. type: Title =
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid "Implementing a Controller"
msgstr ""

#. type: Plain text
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"xref:edge/implement.adoc[Implementing a Device] is a step-by-step tutorial "
"for a device. This page complements it with the parts of an OpenEMS "
"Component and uses a Controller as a template: **Balancing** (self-"
"consumption optimization, bundle "
"`+io.openems.edge.controller.ess.balancing+`), which is small, complete and "
"has a test. For charge points, `+CLAUDE.md+` names the bundles "
"`+io.openems.edge.evse.chargepoint.keba+` and `+…mennekes+` as templates; "
"for Modbus devices see xref:development/implementing/modbus-device-"
"drivers.adoc[Modbus device drivers]."
msgstr ""

#. type: Title ==
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid "Files of a bundle"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"io.openems.edge.controller.ess.balancing/\n"
"  bnd.bnd                         bundle name, -buildpath, -testpath\n"
"  readme.adoc                     description for the documentation\n"
"  src/io/openems/edge/controller/ess/balancing/\n"
"    Config.java                   configuration fields\n"
"    ControllerEssBalancing.java   interface with its own Channels\n"
"    ControllerEssBalancingImpl.java  implementation\n"
"  test/io/openems/edge/controller/ess/balancing/\n"
"    MyConfig.java                 builder for the configuration in the test\n"
"    BalancingImplTest.java        test\n"
msgstr ""

#. type: Plain text
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"In `+bnd.bnd+`, `+-buildpath+` lists all required OpenEMS bundles in "
"addition to `+${buildpath}+`, here `+io.openems.common+`, "
"`+io.openems.edge.common+`, `+io.openems.edge.controller.api+`, "
"`+io.openems.edge.ess.api+`, `+io.openems.edge.meter.api+`. `+${buildpath}+` "
"and `+${testpath}+` are defined in `+cnf/build.bnd+` (Gson, Guava, OSGi "
"annotations, logging, JUnit)."
msgstr ""

#. type: Title ==
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid "Config.java"
msgstr ""

#. type: #sec-config-java
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"The configuration is an annotation with OSGi Metatype. The form in the "
"Apache Felix Web Console and the fields shown by the UI are created from it."
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"@ObjectClassDefinition(name = \"Controller Ess Balancing\",\n"
"        description = \"Optimizes the self-consumption by keeping the grid meter on zero.\")\n"
"@interface Config {\n"
"    @AttributeDefinition(name = \"Component-ID\", description = \"Unique ID of this Component\")\n"
"    String id() default \"ctrlBalancing0\";\n"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"    @AttributeDefinition(name = \"Alias\", description = \"Human-readable name ...\")\n"
"    String alias() default \"\";\n"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"    @AttributeDefinition(name = \"Is enabled?\", description = \"Is this Component enabled?\")\n"
"    boolean enabled() default true;\n"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"    @AttributeDefinition(name = \"Ess-ID\", description = \"ID of Ess device.\")\n"
"    String ess_id();\n"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"    @AttributeDefinition(name = \"Grid-Meter-ID\", description = \"ID of the Grid-Meter.\")\n"
"    String meter_id();\n"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"    @AttributeDefinition(name = \"Target Grid Setpoint\", description = \"...\")\n"
"    int targetGridSetpoint() default 0;\n"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"    String webconsole_configurationFactory_nameHint() default \"Controller Ess Balancing [{id}]\";\n"
"}\n"
msgstr ""

#. type: Plain text
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid "Every component has `+id+`, `+alias+` and `+enabled+`."
msgstr ""

#. type: Plain text
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"An underscore in the method name becomes a dot in the property name: "
"`+ess_id()+` reads the property `+ess.id+`."
msgstr ""

#. type: Plain text
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"`+webconsole_configurationFactory_nameHint+` determines the display name in "
"the Apache Felix Web Console."
msgstr ""

#. type: Title ==
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid "Interface with its own Channels"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"public interface ControllerEssBalancing extends Controller, OpenemsComponent {\n"
"    public enum ChannelId implements io.openems.edge.common.channel.ChannelId {\n"
"        DEBUG_SET_GRID_ACTIVE_POWER(Doc.of(OpenemsType.INTEGER)\n"
"                .accessMode(AccessMode.READ_ONLY)),\n"
"        SET_GRID_ACTIVE_POWER(Doc.of(OpenemsType.INTEGER)\n"
"                .accessMode(AccessMode.WRITE_ONLY)\n"
"                .onChannelSetNextWriteMirrorToDebugChannel(DEBUG_SET_GRID_ACTIVE_POWER));\n"
"        ...\n"
"    }\n"
"}\n"
msgstr ""

#. type: Plain text
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"Here there is a write-channel via which another Controller or an interface "
"can specify the grid setpoint. `+onChannelSetNextWriteMirrorToDebugChannel+` "
"mirrors the written value to a readable Channel so that it is visible in the "
"history and UI."
msgstr ""

#. type: Title ==
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid "Implementation"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"@Designate(ocd = Config.class, factory = true)\n"
"@Component(\n"
"        name = \"Controller.Symmetric.Balancing\",    // Factory-PID, never change\n"
"        immediate = true,\n"
"        configurationPolicy = ConfigurationPolicy.REQUIRE)\n"
"@GenerateTargetsFromReferences({ \"ess\", \"meter\" })\n"
"public class ControllerEssBalancingImpl extends AbstractOpenemsComponent\n"
"        implements Controller, OpenemsComponent, ModbusSlave, ControllerEssBalancing {\n"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"    @Reference(policy = STATIC, policyOption = GREEDY, cardinality = MANDATORY,\n"
"            target = \"(&(id=${config.ess_id})(enabled=true))\")\n"
"    private ManagedSymmetricEss ess;\n"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"    @Reference(policy = STATIC, policyOption = GREEDY, cardinality = MANDATORY,\n"
"            target = \"(&(id=${config.meter_id})(enabled=true))\")\n"
"    private ElectricityMeter meter;\n"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid "    private Config config;\n"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"    public ControllerEssBalancingImpl() {\n"
"        super(OpenemsComponent.ChannelId.values(),\n"
"              Controller.ChannelId.values(),\n"
"              ControllerEssBalancing.ChannelId.values());\n"
"    }\n"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"    @Activate\n"
"    private void activate(ComponentContext context, Config config) {\n"
"        super.activate(context, config.id(), config.alias(), config.enabled());\n"
"        this.config = config;\n"
"    }\n"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"    @Override\n"
"    @Deactivate\n"
"    protected void deactivate() {\n"
"        super.deactivate();\n"
"    }\n"
msgstr ""

#. type: delimited block -
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"    @Override\n"
"    public void run() throws OpenemsNamedException {\n"
"        if (!this.ess.isOnGridOrUndefined(m -> this.logWarn(this.log, m))) {\n"
"            return;\n"
"        }\n"
"        int target = this.getSetGridActivePowerNextWriteValue()\n"
"                .orElse(this.config.targetGridSetpoint());\n"
"        var power = this.meter.getActivePower().getOrError()\n"
"                + this.ess.getActivePower().getOrError() - target;\n"
"        this.ess.setActivePowerEqualsWithFilter(power);\n"
"        this.ess.setReactivePowerEqualsWithoutFilter(0);\n"
"    }\n"
"}\n"
msgstr ""

#. type: Plain text
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"(shortened; in the original, the calculation is in a static method "
"`+calculateRequiredPower+`, which can be tested individually)"
msgstr ""

#. type: Title ===
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid "What the parts do"
msgstr ""

#. type: #sec-what-the-parts-do
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"**`+configurationPolicy = REQUIRE+`**: the component is only created if a "
"configuration exists."
msgstr ""

#. type: #sec-what-the-parts-do
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"**Constructor**: pass all `+ChannelId+` enums of the implemented Natures. If "
"one is missing, its Channels do not exist and access fails at runtime."
msgstr ""

#. type: #sec-what-the-parts-do
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"**`+implements+`**: list all Natures, including parent interfaces (see "
"xref:development/fundamentals/components-and-channels.adoc[Components and "
"Channels in code])."
msgstr ""

#. type: #sec-what-the-parts-do
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"**`+getOrError()+`**: throws an exception if the value is missing (e.g. "
"meter not reachable). The Scheduler catches it and sets `+RunFailed+`. If "
"you want to handle missing values differently, use `+get()+` (can be "
"`+null+`) or `+orElse(…)+`."
msgstr ""

#. type: #sec-what-the-parts-do
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"**Setpoints** to ESS go through ESS Power; details under xref:development/"
"fundamentals/cycle-and-ess-power.adoc[Cycle]."
msgstr ""

#. type: Title ==
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid "References to other components"
msgstr ""

#. type: #sec-references-to-other-components
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"A Controller receives meters and ESS via OSGi `+@Reference+`. Which Instance "
"is meant is specified in the configuration (`+ess_id+`). For OSGi to inject "
"the correct Instance, the reference needs a **target filter** with this ID."
msgstr ""

#. type: #sec-references-to-other-components
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"**New way (139 classes):** `+@GenerateTargetsFromReferences+` from "
"`+io.openems.core.referencetarget+`. `+target+` contains a placeholder `+$"
"{config.ess_id}+`; a configuration plugin replaces it with the value of the "
"property when loading the configuration. The annotation contains the names "
"of the references (field name or, for setter methods such as `+setModbus+`, "
"the reference name)."
msgstr ""

#. type: #sec-references-to-other-components
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"**Old way (still in a few classes):** an additional property `+ess_target+` "
"in the Config and the call `+OpenemsComponent.updateReferenceFilter(cm, "
"servicePid(), \"ess\", config.ess_id())+` in `+activate()+`. This writes the "
"filter to the configuration and triggers a reactivation."
msgstr ""

#. type: #sec-references-to-other-components
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid "Options of the reference:"
msgstr ""

#. type: Table
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid ""
"| Option\n"
"| Effect\n"
"\n"
"| `+cardinality = MANDATORY+`\n"
"| Without a matching component, the Controller is not activated.\n"
"| `+cardinality = OPTIONAL+` / `+MULTIPLE+`\n"
"| none or one / any number of components; with `+policy = DYNAMIC+`, the field must be `+volatile+` or a thread-safe list.\n"
"| `+policy = STATIC+`\n"
"| If the reference changes, the component is reactivated. Simple and safe.\n"
"| `+policy = DYNAMIC+`\n"
"| Reference is replaced at runtime, without reactivation.\n"
"| `+policyOption = GREEDY+`\n"
"| immediately binds a better matching component as soon as it appears.\n"
msgstr ""

#. type: Plain text
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"The filter `+(enabled=true)+` ensures that disabled components are not bound."
msgstr ""

#. type: Title ==
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid "Other common building blocks"
msgstr ""

#. type: #sec-other-common-building-blocks
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"**`+debugLog()+`**: returns a short string that “Controller Debug Log” "
"outputs every second (e.g. `pass:c[\"L:\" + getActivePower().asString()]`)."
msgstr ""

#. type: #sec-other-common-building-blocks
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"**`+ModbusSlave+`**: makes Channels readable or writable via the Modbus/TCP "
"API (`+getModbusSlaveTable()+`)."
msgstr ""

#. type: #sec-other-common-building-blocks
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"**`+EventHandler+`**: for work outside `+run()+` in a Cycle Event; the "
"topics are in the `+@Component+` property `+EventConstants.EVENT_TOPIC+`."
msgstr ""

#. type: #sec-other-common-building-blocks
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"**Clock**: `+componentManager.getClock()+` instead of `+Instant.now()+`; the "
"clock can then be controlled in tests."
msgstr ""

#. type: #sec-other-common-building-blocks
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"**Logging**: `+this.logInfo(log, …)+`, `+logWarn+`, `+logError+` from "
"`+AbstractOpenemsComponent+` prefix the Component-ID."
msgstr ""

#. type: #sec-other-common-building-blocks
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid "**`+readme.adoc+`**: is included in this documentation."
msgstr ""

#. type: Title ==
#: modules/ROOT/pages/development/implementing/controller.adoc
#, no-wrap
msgid "Checklist for a new bundle"
msgstr ""

#. type: #sec-checklist-for-a-new-bundle
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"Create the directory `+io.openems.edge.<area>.<name>+` with `+bnd.bnd+`, "
"`+src+`, `+test+`, `+readme.adoc+` (the easiest way is to copy a similar "
"bundle)."
msgstr ""

#. type: #sec-checklist-for-a-new-bundle
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"Choose a unique Factory-PID in `+@Component(name = …)+`; scheme e.g. "
"`+Controller.Ess.Xyz+`, `+Meter.Manufacturer.Type+`."
msgstr ""

#. type: #sec-checklist-for-a-new-bundle
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"Write a test with `+ComponentTest+`/`+ControllerTest+` (xref:development/"
"testing/component-tests.adoc[Component tests])."
msgstr ""

#. type: #sec-checklist-for-a-new-bundle
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid "Run `+./gradlew :<bundle>:test+` and `+:<bundle>:checkstyleMain+`."
msgstr ""

#. type: #sec-checklist-for-a-new-bundle
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"Enter the bundle in `+io.openems.edge.application/EdgeApp.bndrun+` under `+-"
"runrequires+` so that it is part of the Edge JAR."
msgstr ""

#. type: #sec-checklist-for-a-new-bundle
#: modules/ROOT/pages/development/implementing/controller.adoc
msgid ""
"Follow the xref:development/coding-guidelines.adoc[Coding Guidelines] and "
"run `+./tools/prepare-commit.sh+`."
msgstr ""
